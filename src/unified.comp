// When I was reasoning through the prefix-sum algorithm, there was a specific reason to use u16x2 rather than u32 when accumulating the counters in shared memory 4096*4 (16KiB). I forget why.



layout(constant_id = 1) const u32 const_timestamp_period = 10;
u64 get_time_ns() {return clockRealtimeEXT() * const_timestamp_period;}


// Per Render Descriptors
layout(set = 0, binding = 0, std140) uniform RenderGlobals{
	mat3x3 world_affine;
	mat3x3 overlay_affine;
	float world_zoom;
	float overlay_zoom;

	uint frame_accum;
}render_globals;

layout(set = 0, binding = 1) writeonly uniform image2D target_image;


// Per Update Descriptors
layout(set = 1, binding = 0, std140) uniform UpdateGlobals{
	u32 particles_pointer;
	u32 grid_offsets_pointer;
	u32 grid_square_size;
	u32 particle_count;

	u32 update_accum;
}update_globals;

layout(set = 1, binding = 1) readonly buffer ReadBuffer{
	uint data[];
}read_buffer;

layout(set = 1, binding = 2) writeonly buffer WriteBuffer{
	uint data[];
}write_buffer;

