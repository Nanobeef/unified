#version 450 core
#pragma shader_stage(compute)

#include "unified_comp.h"

layout(constant_id = 0) const u32 const_pipeline_id = 0;
layout(constant_id = 1) const u32 const_timestamp_period = 10;
layout(constant_id = 2) const u32 const_buffer_count = 4096;
layout(constant_id = 3) const u32 const_buffer_granularity = (1024 * 1024);

#if 1
	#extension GL_EXT_debug_printf : enable
	#extension GL_EXT_shader_realtime_clock : enable
	#extension GL_EXT_shader_explicit_arithmetic_types : enable
	#define u64 uint64_t
	u64 get_time_ns() {return clockRealtimeEXT() * const_timestamp_period;}
#endif




layout(local_size_x = 64) in;

void small_simulate();
void small_draw();

void main()
{
	switch(const_pipeline_id)
	{
		case 0: small_simulate(); break;
		case 1: small_draw(); break;
	}
}

u32 load_number(u32x2 offset)
{
	return 0;		
}



layout(set = 0, binding = 0, std140) uniform RenderGlobals{
	mat3x3 world_affine;
	mat3x3 overlay_affine;
	float world_zoom;
	float overlay_zoom;

	uint frame_accum;
	uint show_circles;
}render_globals;

layout(set = 0, binding = 1) writeonly uniform image2D target_image;

layout(set = 1, binding = 0, std140) uniform UpdateGlobals{
	u32 particles_pointer;
	u32 grid_offsets_pointer;
	u32 grid_square_size;
	u32 particle_count;

	u32 update_accum;

	u32 buffer_granularity;
	u32 buffer_rsh;
}update_globals;

layout(set = 1, binding = 1, std140) uniform StorageBufferTable{
	u32 indices[16384];
}storage_buffer_table;

layout(set = 1, binding = 2) readonly buffer ReadBuffer{
	uint data[];
}read_buffer;

layout(set = 1, binding = 3) writeonly buffer WriteBuffer{
	uint data[];
}write_buffer;


void small_simulate()
{
	u32 tid = gl_LocalInvocationID.x;
	u32 rs = tid;
	u32x2 target_size = imageSize(target_image);
	write_buffer.data[tid] = splitmix32(rs) % target_size.x;
	write_buffer.data[tid+64] = splitmix32(rs) % target_size.y;
}

f32x4 u32_to_color(u32 data)
{
	u32 r = (data & 0x000000FF) >> 0;
	u32 g = (data & 0x0000FF00) >> 8;
	u32 b = (data & 0x00FF0000) >> 16;
	u32 a = (data & 0xFF000000) >> 24;
	f32x4 ret = f32x4(r,g,b,a);
	ret /= 256.0;
	return ret;
}

void small_draw()
{
	u32 tid_w = 8;
	u32 tid_h = 8;
	u32 tid = gl_LocalInvocationID.x;
	u32x2 tid2 = u32x2(tid % 8, tid / 8);
	u32x2 target_size = imageSize(target_image);
	u32x2 grid_count = target_size / 8 + 1;
	f32x2 pos = f32x2(read_buffer.data[0], read_buffer.data[64]);
	for(u32 y = 0; y < grid_count.y; y++)
	{
		for(u32 x = 0; x < grid_count.x; x++)
		{
			u32x2 pixel = u32x2(x,y) * 8 + tid2;
			if(pixel.x < target_size.x && pixel.y < target_size.y)
			{
				if(distance(pos, f32x2(pixel)) < 100.0)
				{
					u32 rs = pixel.x + pixel.y * target_size.x;
					u32 r = splitmix32(rs);
					f32x4 color = u32_to_color(r);
					imageStore(target_image, s32x2(pixel), color);
				}
				else
				{
					f32x4 color = f32x4(0.0);
					imageStore(target_image, s32x2(pixel), color);
				}
				
			}

		}
	}


}


