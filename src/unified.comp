#ifdef DRAW
layout(local_size_x = 8, local_size_y = 4, local_size_z = 1) in;
void main()
{


	u32x2 pixel = gl_GlobalInvocationID.xy;
	u32x2 image_size = imageSize(target_image);
	vec2 pos = (vec2(pixel) / vec2(image_size) - 0.5) * 2.0;



	if((pixel.x > image_size.x) || (pixel.y > image_size.y))
		return;


	f32x2 world_pos = (vec3(pos, 1.0) * render_globals.world_affine).xy;

	if(world_pos.x < 1.0 && world_pos.x > -1.0 && world_pos.y < 1.0 && world_pos.y > -1.0)
	{

		u32x2 upos = u32x2(((world_pos / 2.0) + 0.5) * 4294967296.0);
		upos.x >>= (32-6);
		upos.y >>= (32-6);
		u32 cell_index = upos.y * 64 + upos.x;
		u32 counter_offset = 0 + update_globals.particle_count * 4;
		u32 offset_offset = counter_offset + 4096;

		u32 count = read_buffer.data[counter_offset + cell_index];

		f32x4 color = vec4(f32(count) / 10.0, 0.0, 0.0, 1.0);
		imageStore(target_image, s32x2(pixel), color);
		

		for(u32 i = 0; i < count; i++)
		{
			u32 cell_offset = read_buffer.data[offset_offset + cell_index];
			u32 particle_offset = cell_offset * 4;
			u32x2 uparticle_pos;
			uparticle_pos.x = read_buffer.data[particle_offset + 0];
			uparticle_pos.y = read_buffer.data[particle_offset + 1];
			f32x2 particle_pos = ((f32x2(uparticle_pos) / 4294967296.0) - 0.5) * 2.0;

			if(distance(world_pos, particle_pos) < 0.01)
			{
				vec4 color = f32x4(1.0);
				imageStore(target_image, s32x2(pixel), color);
			}
		}
	}





}
#endif // DRAW
