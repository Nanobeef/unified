#version 460
#extension GL_EXT_mesh_shader : require

#include "boid_comp.h"

layout (local_size_x = 1) in;
layout(triangles) out;
layout(max_vertices = 4, max_primitives = 2) out;

layout(location = 0) out vec2 out_position[4];

void main()
{

	const vec2 points[4] = {
		vec2(-1.0, -1.0),
		vec2(-1.0,  1.0),
		vec2( 1.0, -1.0),
		vec2( 1.0,  1.0),
	};

	for(uint i = 0; i < 4; i++)
	{
		out_position[i] = (points[i] + vec2(1.0)) * 0.5;
		vec2 p = transform_position(points[i]);
		gl_MeshVerticesEXT[i].gl_Position = vec4( p, 0.5, 1.0);
	}

	SetMeshOutputsEXT(4,2);


    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0,1,2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(1,3,2);
	
}
